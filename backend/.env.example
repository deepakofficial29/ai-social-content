# Application
APP_NAME=multimodal-caption-generator
APP_ENV=development
DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Upload limits
MAX_UPLOAD_SIZE_MB=100
MAX_REQUEST_SIZE_MB=500
MAX_IMAGE_DIMENSION=10000
MAX_IMAGE_PIXELS=40000000
MAX_VIDEO_DURATION_SECONDS=600
MAX_AUDIO_DURATION_SECONDS=3600
REQUEST_TIMEOUT_SECONDS=180

# Allowed media types (comma-separated extensions)
ALLOWED_IMAGE_TYPES=["jpg","jpeg","png","webp"]
ALLOWED_VIDEO_TYPES=["mp4","mov","avi","mkv","webm"]
ALLOWED_AUDIO_TYPES=["wav","mp3","m4a","aac"]

# Storage – keep outside any web-served directory
STORAGE_DIR=storage

# Database – SQLite for local dev; switch to PostgreSQL for production
# PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/caption_db
DATABASE_URL=sqlite:///./caption_generator.db

# FFmpeg – set full paths if not on system PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# CORS – comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---------------------------------------------------------------------------
# AI Provider Selection
# ---------------------------------------------------------------------------
# Available vision providers:    gemini, gemini-flash
# Available video providers:     gemini, gemini-flash
# Available transcription:       openai-whisper, gemini
# Available audio understanding: gemini, gemini-flash

VISION_PROVIDER=gemini
VIDEO_PROVIDER=gemini
AUDIO_TRANSCRIPTION_PROVIDER=openai-whisper
AUDIO_UNDERSTANDING_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Gemini (Google AI)
# Get your key at: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_VIDEO_MODEL=gemini-2.0-flash
GEMINI_AUDIO_MODEL=gemini-2.0-flash
TEXT_GENERATION_PROVIDER=gemini
GEMINI_TEXT_MODEL=gemini-2.0-flash
MOCK_AI_PROVIDERS=false

# ---------------------------------------------------------------------------
# OpenAI (Whisper transcription)
# Get your key at: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_WHISPER_MODEL=whisper-1

# ---------------------------------------------------------------------------
# Video processing limits
# ---------------------------------------------------------------------------
VIDEO_MAX_DURATION_SECONDS=600
VIDEO_MAX_FRAMES=50
VIDEO_FRAME_INTERVAL_SECONDS=5.0
VIDEO_SCENE_CHANGE_THRESHOLD=0.3
VIDEO_FRAME_WIDTH=1280
VIDEO_PROCESSING_TIMEOUT_SECONDS=300
